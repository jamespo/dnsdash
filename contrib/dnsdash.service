# systemd unit for DNS Dash.
#
# Install:
#   sudo cp contrib/dnsdash.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now dnsdash
#
# To change options, run "sudo systemctl edit dnsdash" and override ExecStart:
#   [Service]
#   ExecStart=
#   ExecStart=/usr/bin/dnsdash -addr 127.0.0.1:9000 -allow-custom-resolver=false

[Unit]
Description=DNS Dash web tool for DNS lookups and mail checks
Documentation=https://github.com/jamespo/dnsdash
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/dnsdash -addr :8080
Restart=on-failure
RestartSec=5s

# Run as a transient, randomly allocated user that exists only while the
# service is running. No user account needs to be created.
DynamicUser=yes

# Listening on a port below 1024 (e.g. -addr :80) needs this capability.
# Uncomment both lines, remove the empty CapabilityBoundingSet and
# AmbientCapabilities below, and set PrivateUsers=no.
#AmbientCapabilities=CAP_NET_BIND_SERVICE
#CapabilityBoundingSet=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes

# Filesystem: the binary only reads /etc/resolv.conf and writes nothing.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
UMask=0077

# Kernel and system.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
PrivateUsers=yes
PrivateIPC=yes
RemoveIPC=yes
KeyringMode=private
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes

# Network: IPv4/IPv6 for HTTP, DNS and RDAP; Unix sockets for logging.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# System calls.
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

# Resource limits.
LimitNOFILE=65536
TasksMax=512

[Install]
WantedBy=multi-user.target
